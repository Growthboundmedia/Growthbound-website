---
// The GBM arrow, redrawn as a single path so it can take currentColor.
// On paper it is graphite; on the graphite title block and in the favicon tile
// it is hi-vis. The original gold gradient is kept only for the large
// standalone mark, because at 16px a gradient turns to mud.
interface Props { size?: number; class?: string }
const { size = 22, class: className } = Astro.props;
---
<svg
  class={className}
  width={size} height={size} viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="2.4"
  stroke-linecap="square" stroke-linejoin="miter"
  aria-hidden="true" focusable="false"
>
  <path d="M3 18 L9.5 11 L14 15 L21 6" vector-effect="non-scaling-stroke" />
  <path d="M15.5 6 L21 6 L21 11.5" vector-effect="non-scaling-stroke" />
</svg>
