---
// TEMPORARY — a preview control, not a site feature.
//
// It exists so Daniel can click through every page in both themes and pick one
// properly, rather than judging a screenshot. Once the choice is locked:
//   1. delete this file
//   2. remove <ThemePreview /> from Base.astro and the inline script in <head>
//   3. if light wins, fold :root[data-theme='light'] into :root in tokens.css
//      and delete the dark values; if dark wins, delete the light block.
// Nothing else references it.
---
<div class="tp" role="group" aria-label="Theme preview">
  <span class="tp-lbl">Preview</span>
  <button type="button" data-theme-set="dark">Dark</button>
  <button type="button" data-theme-set="light">Light</button>
</div>

<style>
  .tp {
    position: fixed; right: 16px; bottom: 16px; z-index: 300;
    display: flex; align-items: center; gap: 4px;
    padding: 5px 5px 5px 12px;
    background: var(--coal); border: 1px solid var(--line-strong);
    border-radius: 100px; box-shadow: var(--lift);
  }
  .tp-lbl {
    font-family: var(--mono); font-size: 9px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--on-dark-soft); margin-right: 4px;
  }
  .tp button {
    border: 0; border-radius: 100px; padding: 7px 13px; cursor: pointer;
    background: transparent; color: var(--on-dark-soft);
    font-family: var(--mono); font-size: 10px; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase;
  }
  .tp button[aria-pressed='true'] { background: var(--amber); color: #14171A; }

  /* The call bar owns the bottom of a phone screen, so move up out of it. */
  @media (max-width: 780px) { .tp { bottom: 70px; } }
  @media print { .tp { display: none; } }
</style>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');

  const paint = (theme: string) => {
    if (theme === 'light') root.setAttribute('data-theme', 'light');
    else root.removeAttribute('data-theme');
    buttons.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.themeSet === theme))
    );
    // Keep the mobile browser chrome in step with the page.
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'light' ? '#F4F2EE' : '#0E1011');
  };

  let saved = 'dark';
  try { saved = localStorage.getItem('gb-theme') || 'dark'; } catch { /* private mode */ }
  paint(saved);

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.themeSet || 'dark';
      try { localStorage.setItem('gb-theme', t); } catch { /* private mode */ }
      paint(t);
    })
  );
</script>
