---
// FAQ. Native <details>, so it works with no JavaScript and every answer is in
// the HTML for a crawler and for an AI assistant reading the page.
// Always paired with faqSchema() on the page that uses it.
interface Props { faqs: readonly { q: string; a: string }[] }
const { faqs } = Astro.props;
---
<div class="faq">
  {faqs.map((f, i) => (
    <details name="faq" open={i === 0}>
      <summary>
        <span class="faq-q">{f.q}</span>
        <span class="faq-mark" aria-hidden="true"></span>
      </summary>
      <div class="faq-a"><p>{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex; align-items: center; gap: 20px; justify-content: space-between;
    padding: 22px 0; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .faq-q {
    font-variation-settings: 'wdth' 110, 'wght' 620;
    font-size: clamp(17px, 1.9vw, 20px); letter-spacing: -0.01em; line-height: 1.3;
  }
  .faq-mark {
    flex: none; width: 22px; height: 22px; position: relative;
    border: 1px solid var(--line-light);
  }
  .faq-mark::before, .faq-mark::after {
    content: ''; position: absolute; background: var(--ink);
    left: 50%; top: 50%; transform: translate(-50%, -50%);
  }
  .faq-mark::before { width: 10px; height: 1.5px; }
  .faq-mark::after { width: 1.5px; height: 10px; transition: opacity var(--fast) var(--ease); }
  details[open] .faq-mark { background: var(--amber); border-color: var(--ink); }
  details[open] .faq-mark::after { opacity: 0; }
  .faq-a { padding-bottom: 24px; }
  .faq-a p { color: var(--on-dark-soft); max-width: 62ch; }
</style>
