---
// The nav is the sheet edge: a hairline, a mark, and the reference numbers of
// the sheets you can turn to. It does not float in a rounded pill.
import { site } from '../data/site';
import { url } from '../lib/url';
import Arrow from './Arrow.astro';

const links = [
  { label: 'Work', href: '/work' },
  { label: 'For builders', href: '/websites-for-builders' },
  { label: 'Pricing', href: '/growth' },
  { label: 'About', href: '/about' },
];
const here = Astro.url.pathname.replace(/\/$/, '');
---
<header class="nav" data-nav>
  <div class="nav-in">
    <a class="nav-mark" href={url('/')} aria-label={`${site.name} home`}>
      <Arrow />
      <span class="nav-word">Growthbound</span>
    </a>

    <nav class="nav-menu" data-nav-menu aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={url(l.href)}
              aria-current={here === l.href ? 'page' : undefined}
            >{l.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav-cta">
        <a class="btn btn-primary" href={url('/contact')}>Get a free demo</a>
      </div>
    </nav>

    <a class="nav-phone" href={`tel:${site.phoneHref}`}>
      <span class="label">Call {site.owner}</span>
      <span class="nav-phone-no">{site.phoneDisplay}</span>
    </a>

    <button class="nav-burger" data-nav-toggle aria-expanded="false" aria-label="Menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: saturate(150%) blur(14px);
    -webkit-backdrop-filter: saturate(150%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease);
  }
  .nav.scrolled { border-bottom-color: var(--line); background: var(--nav-bg-solid); }

  .nav-in {
    max-width: var(--wide); margin-inline: auto;
    padding: 0 var(--gutter);
    height: 68px;
    display: flex; align-items: center; gap: 28px;
  }

  .nav-mark { display: flex; align-items: center; gap: 10px; flex: none; }
  .nav-word {
    font-variation-settings: 'wdth' 112, 'wght' 700;
    font-size: 18px; letter-spacing: -0.02em;
  }

  .nav-menu { display: flex; align-items: center; gap: 28px; margin-left: auto; }
  .nav-menu ul { display: flex; gap: 26px; }
  .nav-menu ul a {
    font-family: var(--mono); font-size: 11px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--on-dark-soft);
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    transition: border-color var(--fast) var(--ease);
  }
  .nav-menu ul a:hover { border-bottom-color: var(--line-strong); color: var(--on-dark); }
  .nav-menu ul a[aria-current='page'] { border-bottom-color: var(--amber); color: var(--on-dark); }
  .nav-cta .btn { padding: 11px 18px; font-size: 11px; }

  .nav-phone { display: none; }

  .nav-burger {
    display: none; background: none; border: 1px solid var(--line-strong);
    width: 42px; height: 38px; padding: 0; cursor: pointer;
    flex-direction: column; align-items: center; justify-content: center; gap: 5px;
  }
  .nav-burger span { display: block; width: 17px; height: 1.5px; background: currentColor; }

  @media (max-width: 940px) {
    .nav-in { gap: 14px; }
    .nav-burger { display: flex; margin-left: auto; }
    .nav-menu {
      position: fixed; inset: 68px 0 0 0;
      background: var(--ink); color: var(--on-dark);
      flex-direction: column; align-items: stretch; justify-content: flex-start;
      gap: 0; padding: 12px var(--gutter) 40px;
      margin-left: 0;
      transform: translateY(-8px); opacity: 0; pointer-events: none;
      transition: opacity var(--fast) var(--ease), transform var(--fast) var(--ease);
      overflow-y: auto;
    }
    .nav-menu.open { transform: none; opacity: 1; pointer-events: auto; }
    .nav-menu ul { flex-direction: column; gap: 0; }
    .nav-menu li { border-bottom: 1px solid var(--line); }
    .nav-menu ul a {
      display: block; padding: 20px 0; font-size: 13px;
      border-bottom: none; color: var(--on-dark);
    }
    .nav-menu ul a[aria-current='page'] { color: var(--amber-text); }
    .nav-cta { margin-top: 26px; }
    .nav-cta .btn { width: 100%; padding: 17px; font-size: 12px; }
  }
</style>
