---
import Base from '../layouts/Base.astro';
import SheetHead from '../components/SheetHead.astro';
import BuildSheet from '../components/BuildSheet.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Arrow from '../components/Arrow.astro';
import Photo from '../components/Photo.astro';
import { site, pricing, proof } from '../data/site';
import { work } from '../data/work';
import { process, ceiling } from '../data/process';
import { generalFaqs } from '../data/faqs';
import { faqSchema, buildService } from '../lib/schema';
import { url } from '../lib/url';

const desc =
  'Growthbound builds lead-generating websites for builders and trades in Newcastle and the Hunter. ' +
  'Standard build $4,000, half to start and half when you are happy. Free demo of your own site in 48 hours.';
---
<Base
  title="Websites for builders and trades | Newcastle | Growthbound"
  description={desc}
  path="/"
  schema={[faqSchema(generalFaqs), buildService()]}
>
  {/* ---------- HERO ---------- */}
  <section class="hero">
    <div class="wrap hero-wrap">
      <div class="hero-copy">
        <p class="eyebrow label">Newcastle &middot; Builders and trades</p>
        <h1>The site your work has been waiting for.</h1>
        <p class="hero-lead">
          I build the website that shows a stranger what your regulars already know,
          then run the thing behind it so the phone keeps going.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={url('/contact')}>Get a free demo</a>
          <a class="btn btn-line" href={url('/work')}>See the work</a>
        </div>
        <p class="hero-note">
          A working demo of your own site in 48 hours, before you commit to anything.
        </p>
      </div>

      <figure class="hero-shot reveal">
        <div class="frame">
          <div class="frame-bar" aria-hidden="true">
            <span class="frame-dot"></span><span class="frame-dot"></span><span class="frame-dot"></span>
            <span class="frame-url">hammondcobuilding.com.au</span>
          </div>
          <Photo
            src="/assets/shot-hammond.png"
            alt="The Hammond and Co Building website, a Newcastle renovations and extensions builder, shown on a desktop browser"
            sizes="(max-width: 1000px) 100vw, 60vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="mono">Concept build &middot; Hammond &amp; Co, Newcastle</figcaption>
      </figure>
    </div>

    <div class="wrap">
      <ul class="hero-stats">
        <li><span class="hs-fig">$4,000</span><span class="hs-lbl mono">Standard build</span></li>
        <li><span class="hs-fig">Half / half</span><span class="hs-lbl mono">Half when you are happy</span></li>
        <li><span class="hs-fig">48 hrs</span><span class="hs-lbl mono">To your free demo</span></li>
        <li><span class="hs-fig">2 to 3 wks</span><span class="hs-lbl mono">Start to live</span></li>
      </ul>
    </div>
  </section>

  {/* ---------- PROOF STRIP ---------- */}
  <section class="strip lit lit-right lit-rule">
    <div class="wrap">
      <div class="strip-in">
        <p class="strip-head">
          <Arrow size={17} class="strip-arrow" />
          <span>{proof.client}, {proof.clientLabel}</span>
        </p>
        <p class="strip-claim">Ranks <em>#2 on Google</em> for muay thai Newcastle.</p>
        <p class="strip-sub">
          Around 2,000 page views a month from 768 visitors, just under half straight off
          search. 260 a month check the prices without ever ringing the desk.
        </p>
        <p class="strip-dim">Measured {proof.measured}</p>
      </div>
    </div>
  </section>

  {/* ---------- 02 THE PROBLEM ---------- */}
  <section class="section on-light" id="why">
    <div class="wrap">
      <SheetHead
        no="02"
        label="The problem"
        dim="Why it matters"
        title="Word of mouth has a ceiling. Google does not."
        lead="Your best work already speaks for itself. The trouble is the customer who has never met you, deciding between you and the next bloke right now, on their phone."
      />
      <div class="grid grid-3">
        {ceiling.map((c) => (
          <div class="panel reveal">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- 03 THE BUILD (SIGNATURE) ---------- */}
  <section class="section lit lit-left" id="build">
    <div class="wrap">
      <SheetHead
        no="03"
        label="The build"
        dim={`${pricing.build.amount} · standard build`}
        title="Here is the whole thing, drawn."
        lead="Not a package with tiers and asterisks. One build, dimensioned, so you can see exactly what you are buying before you buy it."
      />
      <BuildSheet />

      <p class="terms-line stencil">{pricing.build.terms}</p>
      <p class="terms-note">{pricing.build.scopeNote}</p>
    </div>
  </section>

  {/* ---------- 04 THE WORK ---------- */}
  <section class="section" id="work">
    <div class="wrap">
      <SheetHead
        no="04"
        label="The work"
        dim="Click through any of them"
        title="Have a proper look, not a screenshot."
        lead="One live client and two concept builds. All three are real sites you can click every part of, on your phone, right now."
      />
      <div class="grid grid-3">
        {work.map((w) => (
          <a class="wcard panel reveal" href={w.href} rel={w.kind === 'demo' ? 'nofollow' : undefined}>
            <p class="wcard-tag" data-kind={w.kind}>
              {w.kind === 'client' ? 'Live client' : 'Concept build'}
            </p>
            <h3>{w.name}</h3>
            <p class="wcard-meta mono">{w.trade} · {w.place}</p>
            <p>{w.blurb}</p>
            <span class="wcard-go mono">Open it &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- 05 THE CASE FOR IT ----------
       The objection handler, and it sits here on purpose: they have just
       clicked through three real sites, and the next thing they hit is a
       $4,000 number. This is Daniel's own argument, in his own words.
       No claim in it is a measured result. The maths is an if, not a promise. */}
  <section class="section lit lit-right" id="case">
    <div class="wrap">
      <SheetHead
        no="05"
        label="The case for it"
        dim="Why a website at all"
        title="Everything you do to win work ends up here."
        lead="Someone searches your name. Someone scrolls past you on Instagram. Someone gets handed your number at a barbecue. Someone taps an ad. All four end in the same place, on your website, working out whether you are worth ringing."
      />

      <div class="case-body">
        <div class="case-prose reveal">
          <p>
            Word of mouth is the best lead you will ever get, and it is the one you have the
            least control over. It stops when the talking stops. A website does not stop. It
            works while you are on site, while you are asleep, and while the bloke down the
            road is still thinking about ringing someone.
          </p>
          <p>
            That is why it is the backbone and not the extra. The posting, the ads, the
            referrals, the signage on the ute, all of it points at one place. If that place is
            weak, everything pointing at it is wasted.
          </p>
        </div>

        <aside class="case-maths panel reveal">
          <p class="label label-amber">The maths</p>
          <p class="case-fig">{pricing.build.amount}</p>
          <p class="case-aside">You might look at that and think this bloke is dreaming.</p>
          <p>
            Win one extra job off it in the next twelve months and it has paid for the site and
            two more besides. Miss that job because the site looked cheap, and you did not save
            four grand. You just never found out what it cost you.
          </p>
        </aside>
      </div>

      <figure class="case-quote reveal">
        <blockquote>
          You would not eat at a restaurant with a smashed window and a mouldy door. You would
          not even look at the menu.
        </blockquote>
        <figcaption>
          A cheap template does exactly that to work you are proud of. The work is still good.
          Nobody gets far enough in to see it.
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ---------- 06 PRICING ---------- */}
  <section class="section on-light" id="pricing">
    <div class="wrap">
      <SheetHead
        no="06"
        label="Pricing"
        dim="No packages, no asterisks"
        title="The build, then what it costs to keep it running."
        lead="One build, then only what you actually want after it. Everything past the build is month to month and you are never locked in."
      />

      <div class="price-lead panel reveal">
        <div class="price-lead-main">
          <p class="label">{pricing.build.label}</p>
          <p class="price-big">{pricing.build.amount}</p>
          <p class="price-terms stencil">{pricing.build.terms}</p>
        </div>
        <p class="price-scope">{pricing.build.scopeNote}</p>

        {/* The plan is a payment term, not a second product, so it sits under
            the one price rather than beside it in a column of its own. A
            column would invite a comparison and the smaller number always
            wins that. */}
        <div class="price-plan">
          <p class="label label-amber">Or pay it off</p>
          <p class="price-plan-line">{pricing.build.plan.line}</p>
          <p class="price-plan-note">{pricing.build.plan.note}</p>
        </div>
      </div>

      <div class="grid grid-3 price-grid">
        {[pricing.hosting, pricing.growth, pricing.partner].map((t) => (
          <div class="panel reveal">
            <p class="label">{t.label}</p>
            <p class="price-mid">
              {t.amount}{'per' in t && <span class="price-per">{t.per}</span>}
            </p>
            <p class="price-sub mono">{t.terms}</p>
            <p>{t.body}</p>
            <ul class="ticks">
              {t.includes.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <p class="price-foot">
        Hosting and security is an ongoing cost, not part of the build. It starts the day
        the site goes live. Growth replaces it rather than stacking on top of it.
      </p>
    </div>
  </section>

  {/* ---------- 07 PROCESS ---------- */}
  <section class="section" id="process">
    <div class="wrap">
      <SheetHead
        no="07"
        label="The process"
        dim="Mostly my job, not yours"
        title="You stay on the tools."
        lead="Four steps. You see something real before you pay a cent, and the only work on your side is sending photos."
      />
      <ol class="steps">
        {process.map((s) => (
          <li class="step reveal">
            <div class="step-head">
              <span class="label">{s.n}</span>
              <span class="dim">{s.dim}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ---------- 08 FAQ ---------- */}
  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <SheetHead
        no="08"
        label="Questions"
        dim="Answered straight"
        title="Before you get in touch."
      />
      <Faq faqs={generalFaqs} />
    </div>
  </section>

  <Cta
    heading="Let me build you one and you can decide from there."
    body={`Tell me your trade and what you are after. You will have a working demo of your own site inside 48 hours, and you have not committed to a thing.`}
  />
</Base>

<style>
  /* ---- hero ---- */
  .hero { padding-block: clamp(36px, 5vw, 68px) clamp(40px, 5vw, 72px); }
  .hero-wrap {
    display: grid; grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 76px); align-items: center;
  }
  .hero h1 { margin-bottom: 24px; max-width: 15ch; }
  .hero-lead {
    font-size: clamp(17px, 1.9vw, 20.5px); color: var(--on-dark-soft);
    max-width: 42ch; margin-bottom: 34px;
  }
  .hero-note { margin-top: 24px; font-size: 13.5px; color: var(--on-dark-soft); }

  .hero-shot { min-width: 0; }
  .hero-shot figcaption {
    margin-top: 16px; font-size: 10px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--on-dark-soft);
  }

  .hero-stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(44px, 6vw, 80px);
    border-top: 1px solid var(--line);
  }
  .hero-stats li { padding: 24px 20px 0 0; display: grid; gap: 7px; }
  .hero-stats li + li { padding-left: 20px; border-left: 1px solid var(--line); }
  .hs-fig {
    font-variation-settings: 'wdth' 112, 'wght' 680;
    font-size: clamp(20px, 2.3vw, 27px); letter-spacing: -.02em; line-height: 1;
  }
  .hs-lbl { font-size: 10px; letter-spacing: .15em; }

  @media (max-width: 1000px) {
    .hero-wrap { grid-template-columns: 1fr; }
    .hero h1 { max-width: 16ch; }
  }
  @media (max-width: 700px) {
    .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 0; }
    .hero-stats li { padding: 20px 16px 20px 0; }
    .hero-stats li:nth-child(odd) { border-left: none; padding-left: 0; }
    .hero-stats li:nth-child(n+3) { border-top: 1px solid var(--line); }
  }

  /* ---- proof strip ---- */
  .strip { padding-block: clamp(48px, 7vw, 96px); border-block: 1px solid var(--line); }
  .strip-head { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--on-dark-soft); }
  .strip-arrow { color: var(--amber-text); }
  .strip-claim {
    margin-top: 20px;
    font-variation-settings: 'wdth' 116, 'wght' 700;
    font-size: clamp(28px, 4.4vw, 54px); line-height: 1; letter-spacing: -.03em;
    max-width: 18ch;
  }
  .strip-claim :global(em) { font-style: normal; color: var(--amber-text); }
  .strip-sub { margin-top: 20px; font-size: 17px; max-width: 60ch; color: var(--on-dark-soft); }
  .strip-dim { margin-top: 22px; font-family: var(--mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--on-dark-soft); }

  /* ---- build terms ---- */
  .terms-line {
    margin-top: clamp(34px, 5vw, 56px);
    font-size: clamp(26px, 5.2vw, 60px); line-height: 1;
    padding-top: 22px; border-top: 1px solid var(--line-light);
  }
  .terms-note { margin-top: 12px; font-size: 14px; color: var(--on-dark-soft); }

  /* ---- work cards ---- */
  .wcard { display: flex; flex-direction: column; gap: 9px; transition: background var(--fast) var(--ease); }
  .wcard:hover { background: var(--bone); }
  /* This block never got the pill treatment the /work rows did, so it was
     still the pre-rewrite version: an amber fill with NO colour of its own, so
     the card's light text sat on it. That washed-out light-on-amber is the
     clash. Same treatment as .wrow-tag now, one size down for the card.
     `border: var(--ink)` and `color: var(--ink)` were also left over from when
     --ink meant the dark ink on a light page; --ink is now the page itself, so
     both were drawing near-black on near-black. */
  .wcard-tag {
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start;
    font-family: var(--mono); font-size: 10px; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase;
    padding: 6px 12px 6px 9px; border-radius: 100px;
    border: 1px solid var(--line); color: var(--on-dark-soft);
  }
  .wcard-tag::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--line-strong); flex: none;
  }
  .wcard-tag[data-kind='client'] {
    color: var(--amber);
    border-color: color-mix(in srgb, var(--amber) 42%, transparent);
    background: color-mix(in srgb, var(--amber) 10%, transparent);
  }
  .wcard-tag[data-kind='client']::before { background: var(--amber); }

  .wcard-meta { font-size: 11px; letter-spacing: .1em; }
  .wcard-go {
    margin-top: auto; padding-top: 16px; font-size: 11px;
    letter-spacing: .14em; color: var(--on-dark);
  }
  .wcard:hover .wcard-go { color: var(--amber); }

  /* ---- the case for it ----
     Deliberately not another three-panel grid. It sits between two sections
     that both use one, so a prose column with a single pulled-out figure is
     what stops it reading as more of the same. */
  .case-body {
    display: grid; grid-template-columns: 1.35fr 1fr;
    gap: clamp(22px, 3vw, 54px); align-items: start;
  }
  .case-prose p {
    font-size: clamp(17px, 1.85vw, 20px); line-height: 1.6;
    max-width: 46ch; color: var(--on-dark);
  }
  .case-prose p + p { margin-top: 22px; }

  .case-maths { display: flex; flex-direction: column; }
  /* .panel p greys body copy, which is right for a paragraph and wrong for
     the figure. It is the loudest thing in the panel, so it takes the full
     ink rather than the soft one. */
  .case-fig {
    font-family: var(--grotesk); font-weight: 700;
    font-size: clamp(46px, 6vw, 78px); line-height: .95;
    letter-spacing: -.02em; margin: 10px 0 16px; color: var(--on-dark);
  }
  .case-aside {
    font-family: var(--mono); font-size: 13px; line-height: 1.5;
    color: var(--amber-text); margin-bottom: 14px;
  }

  /* Same two columns as .case-body above, so the quote and its answer land on
     the same vertical lines as the prose and the figure. Bottom-aligned: the
     caption is the reply to the quote, so it sits with it, not above it. */
  .case-quote {
    margin-top: clamp(34px, 4.5vw, 62px);
    padding-top: clamp(26px, 3vw, 40px);
    border-top: 1px solid var(--line);
    display: grid; grid-template-columns: 1.35fr 1fr;
    gap: clamp(20px, 3vw, 54px); align-items: end;
  }
  .case-quote blockquote {
    font-size: clamp(23px, 3.1vw, 42px); line-height: 1.15;
    letter-spacing: -.015em; max-width: 26ch; text-wrap: balance;
  }
  .case-quote figcaption {
    font-size: clamp(15px, 1.6vw, 17px);
    max-width: 34ch; color: var(--on-dark-soft);
    padding-bottom: 6px;
  }

  /* ---- pricing ---- */
  .price-lead {
    display: flex; flex-wrap: wrap; gap: 24px 48px;
    align-items: flex-end; justify-content: space-between;
    margin-bottom: 1px;
  }
  .price-big {
    font-family: var(--grotesk); font-variation-settings: 'wdth' 110, 'wght' 700; font-size: clamp(46px, 8vw, 88px);
    font-weight: 600; line-height: 1; letter-spacing: -.03em; margin-top: 8px;
    color: var(--on-dark);
  }
  .price-terms { font-size: clamp(15px, 2vw, 21px); margin-top: 10px; }
  .price-scope { font-size: 14px; color: var(--on-dark-soft); max-width: 34ch; }

  /* Spans the whole card and sits under a rule, so it reads as a second way to
     pay the one price rather than a cheaper tier sitting next to it. */
  .price-plan {
    flex-basis: 100%;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .price-plan-line {
    font-size: clamp(17px, 1.9vw, 22px);
    margin-top: 8px; color: var(--on-dark);
  }
  .price-plan-note { font-size: 14px; color: var(--on-dark-soft); margin-top: 6px; }

  .price-grid .card { display: flex; flex-direction: column; }
  .price-mid { font-family: var(--grotesk); font-variation-settings: 'wdth' 110, 'wght' 700; font-size: 38px; font-weight: 600; letter-spacing: -.02em; margin-top: 10px; color: var(--on-dark); }
  .price-per { font-size: 15px; font-weight: 400; color: var(--on-dark-soft); letter-spacing: 0; }
  .price-sub { font-size: 10.5px; letter-spacing: .14em; margin: 6px 0 14px; }
  .ticks { margin-top: 16px; display: grid; gap: 9px; }
  .ticks li { position: relative; padding-left: 20px; font-size: 14.5px; color: var(--on-dark-soft); line-height: 1.5; }
  .ticks li::before {
    content: ''; position: absolute; left: 0; top: .55em;
    width: 9px; height: 9px; background: var(--amber);
  }
  .price-foot { margin-top: 28px; font-size: 14.5px; color: var(--on-dark-soft); }

  /* ---- steps ---- */
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .step { padding: 26px 24px 26px 0; border-top: 2px solid var(--on-dark); }
  .step + .step { padding-left: 24px; border-left: 1px solid var(--line); }
  .step-head { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 18px; }
  .step h3 { margin-bottom: 10px; }
  .step p { font-size: 15px; color: var(--on-dark-soft); }
  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .step + .step { padding-left: 0; border-left: none; }
  }

  @media (max-width: 900px) {
    .case-body, .case-quote { grid-template-columns: 1fr; }
    .case-prose p { max-width: none; }
    .case-quote figcaption { padding-bottom: 0; margin-top: 20px; }
  }

  .faq-wrap { max-width: 900px; }
</style>
